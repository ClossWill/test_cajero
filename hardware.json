{
  // Editar en la máquina real; no requiere recompilar. Los valores marcados VERIFICAR son supuestos.
  "Recicladora": {
    // Confirmados con la demo y el PDF del SDK de GRG (CRM9250NDev_V2.3.7.6).
    "NombreDispositivoLogico": "CRM9250NDev", // nodo [CRM9250NDev] de GRGDTATM_CommCfg.ini
    "CodigoExito": 0,                         // la demo compara ret == 0
    "ModoAtc": 1,                             // byAtcMode: 1 = auditoría y RC
    "ModoTrabajo": 0,                         // 0 = modo CRM
    "AceptarTodasDenominaciones": 1,          // byDcAccepetAllDenom: acepta todas las de awAcceptableDenom
    "ConfigInicio": 0,
    "LimiteDeposito": 10,
    "TipoDispensa": 1,                        // byDispType: 1 = dispensar por casete RC
    "DestinoRechazoDispensa": 1,              // byRejectToAc: 1 = AC1, 2 = AC2, 3 = LRB
    "DestinoRechazoDeposito": 1,              // byRejectPos: 1 = AC1, 2 = AC2, 3 = LRB
    "MaxBilletesPrueba": 5,
    "SegundosRetiroBilletes": 60,             // espera a que retiren lo dispensado; luego cierra el shutter solo
    "SegundosColocarBilletes": 60,            // depósito: espera a que coloquen billetes tras abrir el shutter
    "SegundosAcomodoBilletes": 3,             // depósito: margen tras detectar billetes antes de cerrar
    "MaxLotesDeposito": 10,                   // depósito: tope de conteos por transacción (LimiteDeposito = billetes por conteo)
    "FamiliaDenominacionPorMoneda": { "MXN": 8, "USD": 3 },  // byte alto del código del NV: 0x08xx = MXN, 0x03xx = USD (por confirmar)
    "DestinoRetract": 2,                      // byRetractPos de iRetractEx: 1 = LRB, 2 = AC, 3 = NE
    "IntentosRecuperacion": 3,                // reinicios tras dispensa fallida antes de pedir mantenimiento
    "ModoValidacionBilletes": 0,              // NOTEVALIDMODE del SDK: 0 = billete real (PRODUCCIÓN), 15 = billete simulado (pruebas)
    // Mapa físico. "Indice" = número RC del SDK, base 1 (RC2 = 2 en la demo). Orden corregido según observación
    // física de la gaveta (2026-10-15): al jalarla, el primero en salir es USD 20, luego MXN 100, 200, 500 y
    // al final el recycler de banda azul. Esto contradice el orden que traía56el TAC_Logical_Tecnica §2 (que
    // ponía MXN 500 antes de MXN 100) — se prioriza la observación física, PERO sigue sin confirmarse que
    // "posición en la gaveta" == "número RC del SDK" (es la suposición más razonable, no un hecho verificado
    // por el SDK). VERIFICAR dispensando 1 billete de cada Indice y que el asistente confirme a simple vista
    // qué denominación salió (ya lo hace Test_DispensarBilletes al preguntar "¿Cuántos billetes de X ve?").
    "Casetes": [
      { "Indice": 1, "Nombre": "Cassette 1", "Moneda": "USD", "Denominacion": 20 },
      { "Indice": 2, "Nombre": "Cassette 2", "Moneda": "MXN", "Denominacion": 100 },
      { "Indice": 3, "Nombre": "Cassette 3", "Moneda": "MXN", "Denominacion": 200 },
      { "Indice": 4, "Nombre": "Cassette 4", "Moneda": "MXN", "Denominacion": 500 }
    ],
    // Se llena con lo observado en Test_AceptarBilletes: código del SDK -> etiqueta. Ej. "12": "USD 20"
    // Códigos grabados en cada casete (opción 22, 2026-10-21); la moneda sale del orden RC1..RC4 de arriba, por confirmar con el primer depósito.
    "EtiquetaDenominacion": { "821": "USD 20", "2135": "MXN 100", "2120": "MXN 200", "2121": "MXN 500" }
  },
  "Monederos": {
    "BaudRate": 9600,
    "MaxMonedasPrueba": 10,
    "Hoppers": [
      { "Nombre": "MK4 #1 ($1 MXN)", "Denominacion": 1, "Puerto": "COM1", "Direccion": 3 },
      { "Nombre": "MK4 #2 ($5 MXN)", "Denominacion": 5, "Puerto": "COM1", "Direccion": 4 }
    ]
  },
  "Escaner": {
    "Simulado": false,                       // cambiado a false el 2026-10-16 para probar Test_PingEscaner contra el lector real (el "OK" anterior fue del stub simulado)
    "TimeoutSegundos": 30,
    "CarpetaCapturas": "C:\\Users\\1\\Pictures" // aquí se copia la imagen escaneada (color, y IR/UV si el SDK las entrega)
  },
  "Impresora": {
    "Modo": "Spooler",                       // vuelto a Spooler el 2026-10-17: el SDK (UsbSdk) no se pudo destrabar en esta máquina; logo y tamaños de fuente ahora se arman con ESC/POS crudo (ver EscPos.cs), no dependen del SDK
    "NombreImpresora": "POS80 Printer",       // cola instalada por el driver POS80 (Get-Printer, 2026-10-14)
    "Puerto": "COM4",                        // sin confirmar; solo se usa si Modo="Serial"
    "BaudRate": 115200,
    "NombreUsb": "POS80",                    // sin usar mientras Modo no sea "UsbSdk"; el SDK no abría el puerto en esta máquina (ver AutoReplyPrintSdk.Abrir)
    "RutaLogo": "logo.png"                   // relativa a la carpeta del .exe (se copia junto al build); solo usada por Test_ImprimirVoucherOperacion
  },
  "Sensores": {
    // Solo existen dos sensores, en las entradas de la tarjeta de 18 canales (puerto/baudios: sección Leds). Mapa observado 2026-10-29.
    "EntradaVibracion": 1,       // reposo en 1, pulsos a 0 de ~0.35-0.5 s por golpe
    "EntradaPresencia": 2,       // nivel sostenido mientras hay alguien frente a la puerta
    "NivelActivoVibracion": 0,
    "NivelActivoPresencia": 1,   // 1 = persona detectada, 0 = libre (E2 en 0 con la máquina vacía, 2026-10-29)
    "AgruparVibracionMs": 2000,  // pulsos más juntos que esto cuentan como un solo golpe
    "FallasParaAlarma": 3
  },
  "Leds": {
    // Tarjeta aparte del ALB02: "18-Channel LED Light Bar Control Board" (modelo 24002-2). Confirmado en
    // referencias_integracion/Multifunctional serial control module: 19200 baudios, protocolo DLE/STX/ETX/BCC.
    "Puerto": "COM2", // confirmado en la máquina real (2026-10-16): firmware "ADK LEDBOX V2.0-20240613"
    "BaudRate": 19200,
    "Canales": 18,
    "PerifericosEsperados": 5, // recibo, moneda, pasaporte, QR, efectivo; la prueba se detiene al identificarlos
    "SegundosPausaBarrido": 60, // cada canal queda encendido este tiempo en el barrido
    // Observado en el gabinete (2026-10-23): OUT -> ícono que enciende. El resto de canales no tiene ícono conectado.
    "Indicadores": { "1": "Impresora", "2": "Monedas", "3": "Pasaporte", "4": "QR", "5": "Recicladora" },
    "BarrerTodosLosCanales": false // true = recorre los 18 canales (18 min) para re-explorar
  },
  "Qr": {
    // XZG004 (item 10 BEEX). "Teclado" = HID-KBW, como llega de fábrica (en la máquina aparece como HID Keyboard VID_26F1&PID_D101).
    // Modo "Serial" según "Command Mode Usage Instructions.pdf" (proveedor). Configuración previa del lector, en este
    // orden, escaneando del "XZG Quick Setup Manual": "USB Virtual Serial Port" ($>:S0F0216.<$) y "Key Mode"
    // (BATCHST, S01010F, S03001A, S030000, S01000F, BATCHET). No escanear otros códigos entre medio.
    // Los comandos son ASCII literal, sin terminador. Se escriben sin envoltorio, como en el documento del proveedor.
    // "Envoltorio": true los envía como $>:código.<$ ; false, el código tal cual (SW00001). No está confirmado cuál acepta
    // el lector por serial: probar ambos (la opción 38 del menú alterna en ejecución).
    "Modo": "Serial",   // pasado a USB CDC el 2026-11-04; el lector aparece como COM15
    "Puerto": "COM15",
    "BaudRate": 115200, // 8N1; por defecto según el proveedor
    // Bloque de luz (antes de activar): S0C0400 = luz encendida solo mientras lee. Vaciar para probar sin él.
    "Envoltorio": true,
    "PrepararEnLote": true,   // el bloque de luz va como una sola cadena con ';' (formato Batch Programming); false = comando por comando
    "ComandosPreparar": [ "BATCHST", "S01010F", "S0C0400", "S01000F", "BATCHET" ],
    "ComandosActivar": [ "SW00001" ],      // inicia la lectura (continua)
    "ComandosDesactivar": [ "SWFFFFF" ],   // detiene la lectura
    "PausaEntreComandosMs": 50,
    "TimeoutSegundos": 30,
    "SilencioTramaMs": 100,
    "SegundosPorComando": 5   // opción 32: segundos de observación tras activar y tras desactivar
  },
  "Camara": {
    // Item 12 del BEEX (GDZS-DC004-MG3021): webcam USB estándar, sin SDK propio.
    // La vista previa elige la cámara cuyo nombre DirectShow contiene este texto (en la laptop no existe: pregunta cuál usar).
    "NombreDispositivo": "GDZS-010101-03M-V",
    "IndiceDispositivo": 1, // GDZS-010101-03M-V (visible, a color) en DirectShow; 0 = GDZS-020202-02M-IR (grises)
    "CarpetaCapturas": "C:\\Users\\1\\Pictures"
  }
}
